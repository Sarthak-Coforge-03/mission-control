# Copy to .env and fill in. .env is gitignored; never commit real values.

# SQLite file location. Empty = default backend/data/db.sqlite3
MC_DB_PATH=

# Django secret key. Empty = an insecure dev-only key; set a real one outside local dev
DJANGO_SECRET_KEY=

# true for local dev, false in Docker
DJANGO_DEBUG=true

# Comma-separated hosts Django will serve
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by the model client later; tests never need it
ANTHROPIC_API_KEY=
