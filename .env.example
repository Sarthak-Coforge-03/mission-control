# Copy to .env and fill in. .env is gitignored; never commit real values.

# SQLite file location. Empty = default data/db.sqlite3 at the repo root
MC_DB_PATH=

# Django secret key. Empty = an insecure dev-only key; set a real one outside local dev
DJANGO_SECRET_KEY=

# true for local dev, false in Docker
DJANGO_DEBUG=true

# Comma-separated hosts Django will serve
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Claude on Microsoft Foundry; tests never need these
ANTHROPIC_FOUNDRY_ENDPOINT=
ANTHROPIC_FOUNDRY_API_KEY=
# Empty = claude-opus-5-5-fast
ANTHROPIC_FOUNDRY_DEPLOYMENT=
